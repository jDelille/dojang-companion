# Reference only: merge the required values into your existing server environment.
# Never replace an existing DOJANG_COOKIE_SECRET or copy credentials to NEXT_PUBLIC_*.
# This slice enables paired session reads, not identification or attendance writes.
DOJANG_INTEGRATION_MODE=odoo-test
DOJANG_PUBLIC_ORIGIN=http://localhost:3000
DOJANG_ODOO_URL=http://127.0.0.1:8074
# Values must match the scoped Odoo test kiosk configuration.
DOJANG_KIOSK_TOKEN=
DOJANG_KIOSK_GATEWAY_KEY=
# Separate staff-entered pairing secret (32–256 characters), never the gateway key.
DOJANG_KIOSK_PAIR_KEY=
# Use the application's existing cookie secret (32–256 characters).
DOJANG_COOKIE_SECRET=
# To use sample kiosk data in development, explicitly select:
# DOJANG_INTEGRATION_MODE=fixture
